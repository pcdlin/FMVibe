# Builds the factory presets into the code: writes OUTPUT, a .cpp defining factoryPresets() (src/factory.h) with each
# preset file's bytes as an array, in the order LIST names them (presets/factory.txt; # starts a comment). DIR holds
# the files, <name>.fmv each. Run as a script: cmake -DLIST=... -DDIR=... -DOUTPUT=... -P embed_presets.cmake
# The output is only rewritten when it changes, so a build that changed no preset compiles nothing.

# A script run with -P sets no policies of its own: without this, CMake 3 reads IN_LIST below as an unknown argument.
cmake_minimum_required(VERSION 3.25)

file(STRINGS "${LIST}" lines ENCODING UTF-8)
set(names "")
foreach(line IN LISTS lines)
    string(STRIP "${line}" line) # a checkout may end its lines in CR LF
    if (NOT line STREQUAL "" AND NOT line MATCHES "^#")
        list(APPEND names "${line}")
    endif()
endforeach()

set(arrays "")
set(entries "")
set(n 0)
foreach(name IN LISTS names)
    if (name MATCHES "[\"\\\\]")
        message(FATAL_ERROR "${LIST}: a preset's name can't hold a quote or a backslash: ${name}")
    endif()
    set(file "${DIR}/${name}.fmv")
    if (NOT EXISTS "${file}")
        message(FATAL_ERROR "${LIST} names ${name}, but there is no ${file}")
    endif()
    file(READ "${file}" hex HEX)
    string(LENGTH "${hex}" length)
    if (length EQUAL 0)
        message(FATAL_ERROR "${file} is empty")
    endif()
    # Sixteen bytes a line (CMake's regular expressions have no counts, hence the pattern spelled out).
    string(REPEAT "[0-9a-f]" 32 row)
    string(REGEX REPLACE "(${row})" "\\1\n    " hex "${hex}")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(STRIP "${bytes}" bytes)
    string(APPEND arrays "// ${name}\nconst unsigned char kPreset${n}[] = {\n    ${bytes}\n};\n")
    string(APPEND entries "        {\"${name}\", kPreset${n}},\n")
    math(EXPR n "${n} + 1")
endforeach()

# Every file is named in the list, so none is left out of the plugin by mistake.
file(GLOB files RELATIVE "${DIR}" "${DIR}/*.fmv")
foreach(file IN LISTS files)
    string(REGEX REPLACE "\\.fmv$" "" name "${file}")
    if (NOT "${name}" IN_LIST names)
        message(FATAL_ERROR "${DIR}/${file} isn't named in ${LIST}: add it at the end")
    endif()
endforeach()

set(code "// Generated by cmake/embed_presets.cmake from presets/factory.txt and presets/Factory/*.fmv: edit those.

#include \"factory.h\"

namespace fmvibe {

namespace {

${arrays}
} // namespace

const std::vector<FactoryPreset> &factoryPresets() {
    static const std::vector<FactoryPreset> presets{
${entries}    };
    return presets;
}

} // namespace fmvibe
")
file(CONFIGURE OUTPUT "${OUTPUT}" CONTENT "${code}" @ONLY NEWLINE_STYLE LF)
